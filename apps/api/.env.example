PORT=3000
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=0
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/syllentra
# use the command [Convert]::ToBase64String((1..64 | ForEach-Object {Get-Random -Maximum 256})) in
# terminal to generate a random secret
JWT_SECRET=replace_with_at_least_32_characters
JWT_EXPIRES_IN=1d
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
