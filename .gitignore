# ── Local dev dependencies (cloned by setup.sh, not owned by this repo) ──────
# These live in ~/AI-LMS-Tool-deps/ in WSL2, but gitignore them here in case
# anyone clones them locally under this directory.
/moodle/
/moodle-docker/

# ── Environment secrets ───────────────────────────────────────────────────────
.env

# ── Node / NestJS ─────────────────────────────────────────────────────────────
node_modules/
api/node_modules/
api/dist/
api/.tsbuildinfo
api/tsconfig*.tsbuildinfo

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# ── Docker volumes (if accidentally created locally) ──────────────────────────
pgdata/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
