generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  INSTRUCTOR
  REVIEWER
  STUDENT
}

enum ContentType {
  LECTURE_NOTE
  ASSIGNMENT
  QUIZ
  RUBRIC
  POLICY_PAGE
  READING_MATERIAL
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  NEEDS_REVISION
  REJECTED
}

enum ReviewStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ReviewAgentType {
  STRUCTURE
  CLARITY
  ALIGNMENT
  SAFETY_POLICY
  SYNTHESIS
}

enum ConfidenceLabel {
  LOW
  MEDIUM
  HIGH
}

enum HumanDecisionType {
  APPROVED
  NEEDS_REVISION
  REJECTED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
}

enum NotificationType {
  ANNOUNCEMENT
  CONTENT_POSTED
}

model User {
  id                String                @id @default(cuid())
  email             String                @unique
  passwordHash      String
  fullName          String
  role              UserRole
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  createdCourses    Course[]              @relation("CourseCreatedBy")
  instructedCourses Course[]              @relation("CourseInstructor")
  enrollments       Enrollment[]          @relation("EnrollmentStudent")
  createdContent    ContentItem[]         @relation("ContentCreatedBy")
  reviewRequests    ReviewRequest[]       @relation("ReviewRequestedBy")
  humanDecisions    HumanReviewDecision[] @relation("DecisionByUser")
  coachingMessages  CoachingMessage[]     @relation("CoachingByUser")
  auditLogs         AuditLog[]            @relation("AuditByUser")
  submissions       StudentSubmission[]   @relation("SubmissionByStudent")
  gradedSubmissions StudentSubmission[]   @relation("SubmissionGradedBy")
  announcements     CourseAnnouncement[]  @relation("AnnouncementCreatedBy")
  calendarEvents    CalendarEvent[]       @relation("CalendarEventCreatedBy")
  notifications     Notification[]        @relation("NotificationForUser")
  attachments       FileAttachment[]      @relation("AttachmentUploadedBy")
}

model Course {
  id              String        @id @default(cuid())
  title           String
  description     String?
  backgroundImage String?
  createdById     String
  createdBy       User          @relation("CourseCreatedBy", fields: [createdById], references: [id])
  instructorId    String?
  instructor      User?         @relation("CourseInstructor", fields: [instructorId], references: [id])
  enrollments     Enrollment[]
  announcements   CourseAnnouncement[]
  notifications   Notification[]
  modules         CourseModule[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model CourseModule {
  id               String        @id @default(cuid())
  courseId         String
  course           Course        @relation(fields: [courseId], references: [id])
  title            String
  description      String?
  learningOutcomes String?
  contentItems     ContentItem[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model ContentItem {
  id              String                @id @default(cuid())
  moduleId        String
  module          CourseModule          @relation(fields: [moduleId], references: [id])
  title           String
  contentType     ContentType
  body            String
  dueAt           DateTime?
  status          ContentStatus         @default(DRAFT)
  rubricText      String?
  createdById     String
  createdBy       User                  @relation("ContentCreatedBy", fields: [createdById], references: [id])
  reviewRequests  ReviewRequest[]
  coachingMessage CoachingMessage[]
  submissions     StudentSubmission[]
  attachments     FileAttachment[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model ReviewRequest {
  id             String               @id @default(cuid())
  contentItemId  String
  contentItem    ContentItem          @relation(fields: [contentItemId], references: [id])
  requestedById  String
  requestedBy    User                 @relation("ReviewRequestedBy", fields: [requestedById], references: [id])
  status         ReviewStatus         @default(PENDING)
  startedAt      DateTime             @default(now())
  completedAt    DateTime?
  agentReviews   AgentReview[]
  finalSummary   FinalReviewSummary?
  humanDecisions HumanReviewDecision[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model AgentReview {
  id               String          @id @default(cuid())
  reviewRequestId  String
  reviewRequest    ReviewRequest   @relation(fields: [reviewRequestId], references: [id])
  agentType        ReviewAgentType
  findings         String
  confidenceScore  Float?
  confidenceLabel  ConfidenceLabel?
  suggestedActions String?
  createdAt        DateTime        @default(now())
}

model FinalReviewSummary {
  id               String         @id @default(cuid())
  reviewRequestId  String         @unique
  reviewRequest    ReviewRequest  @relation(fields: [reviewRequestId], references: [id])
  summaryText      String
  qualityScore     Int?
  suggestedAction  String?
  confidenceLabel  ConfidenceLabel?
  createdAt        DateTime       @default(now())
}

model HumanReviewDecision {
  id             String            @id @default(cuid())
  reviewRequestId String
  reviewRequest  ReviewRequest     @relation(fields: [reviewRequestId], references: [id])
  decidedById    String
  decidedBy      User              @relation("DecisionByUser", fields: [decidedById], references: [id])
  decision       HumanDecisionType
  notes          String?
  createdAt      DateTime          @default(now())
}

model CoachingMessage {
  id             String      @id @default(cuid())
  contentItemId  String
  contentItem    ContentItem @relation(fields: [contentItemId], references: [id])
  userId         String
  user           User        @relation("CoachingByUser", fields: [userId], references: [id])
  question       String
  response       String
  createdAt      DateTime    @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation("AuditByUser", fields: [actorId], references: [id])
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
}

model Enrollment {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  studentId String
  student   User     @relation("EnrollmentStudent", fields: [studentId], references: [id])
  createdAt DateTime @default(now())

  @@unique([courseId, studentId])
}

model StudentSubmission {
  id            String           @id @default(cuid())
  contentItemId String
  contentItem   ContentItem      @relation(fields: [contentItemId], references: [id])
  studentId     String
  student       User             @relation("SubmissionByStudent", fields: [studentId], references: [id])
  answerText    String
  status        SubmissionStatus @default(DRAFT)
  score         Int?
  feedback      String?
  gradedById    String?
  gradedBy      User?            @relation("SubmissionGradedBy", fields: [gradedById], references: [id])
  submittedAt   DateTime?
  gradedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  attachments   FileAttachment[]

  @@unique([contentItemId, studentId])
}

model CourseAnnouncement {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  title       String
  body        String
  createdById String
  createdBy   User     @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  createdById String?
  createdBy   User?    @relation("CalendarEventCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationForUser", fields: [userId], references: [id])
  courseId  String?
  course    Course?          @relation(fields: [courseId], references: [id])
  type      NotificationType
  title     String
  message   String
  entityId  String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model FileAttachment {
  id            String             @id @default(cuid())
  originalName  String
  mimeType      String
  sizeBytes     Int
  storagePath   String
  uploadedById  String
  uploadedBy    User               @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])
  contentItemId String?
  contentItem   ContentItem?       @relation(fields: [contentItemId], references: [id])
  submissionId  String?
  submission    StudentSubmission? @relation(fields: [submissionId], references: [id])
  createdAt     DateTime           @default(now())
}
