# ═══════════════════════════════════════════════════════════════
#  AI-LMS-Tool — Environment Variables
#  Copy this file to .env and fill in the values.
#  Run setup.sh first — it sets MOODLE_DOCKER_WWWROOT automatically.
#  NEVER commit .env to source control.
# ═══════════════════════════════════════════════════════════════

# ── Moodle Docker ────────────────────────────────────────────────────────────
# Automatically set by setup.sh to the WSL2-native absolute path of moodle/.
# Must be an absolute path — moodle-docker requires it.
MOODLE_DOCKER_WWWROOT=

MOODLE_DOCKER_DB=mariadb
MOODLE_DOCKER_PHP_VERSION=8.3
MOODLE_DOCKER_WEB_PORT=8000
# Set to 1 to enable Xdebug in the Moodle webserver container (dev only)
MOODLE_DOCKER_XDEBUG=1

# ── Moodle App ───────────────────────────────────────────────────────────────
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=
MOODLE_ADMIN_EMAIL=admin@example.com
# Generated after first boot:
# Site admin → Plugins → Web services → Manage tokens → Create token
MOODLE_TOKEN=

# ── API PostgreSQL DB ────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=syllentras
POSTGRES_USER=api_user
POSTGRES_PASSWORD=
# Update CHANGEME below with your POSTGRES_PASSWORD value
DATABASE_URL=postgresql://api_user:CHANGEME@postgres:5432/syllentras

# ── NestJS API ───────────────────────────────────────────────────────────────
API_PORT=3000
API_DEBUG_PORT=9229
NODE_ENV=development
# Docker-internal URL the API uses to reach Moodle's REST API.
# In production, change this to your deployed Moodle URL.
MOODLE_INTERNAL_URL=http://webserver
# Host header for internal Moodle requests. moodle-docker reserves the
# hostname "webserver" for Behat; this must match $CFG->wwwroot (host:port).
MOODLE_INTERNAL_HOST=localhost:8000
# Browser-facing Moodle origin for citation/view links. Leave empty for local
# (defaults to MOODLE_INTERNAL_HOST). Set automatically by `./dev.sh tunnel`.
MOODLE_PUBLIC_URL=
# AI provider API keys — leave blank to disable that provider in the chatbox.
# Keys stay on the NestJS API only; they are never sent to the browser.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
# Optional model overrides (defaults are fine for most local setups)
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# XAI_MODEL=grok-3-mini
# MISTRAL_MODEL=mistral-small-latest
# Allowed CORS origin — must match where Moodle is served.
# Comma-separated list is allowed (Behat uses http://webserver).
# In production, change this to your deployed Moodle domain.
CORS_ORIGIN=http://localhost:8000
# In-process LLM stub for Behat/Selenium. Leave false for real chat.
# CI must set this to true so acceptance tests never call a vendor API.
STUB_LLM=false

# ── Chat attachments (persistent file storage) ───────────────────────────────
# Local/Docker volume path inside the API container (see api_uploads volume).
ATTACHMENT_STORAGE_PATH=/app/uploads
# Per-user quota in bytes (default 2 GiB).
ATTACHMENT_USER_QUOTA_BYTES=2147483648
# Delete abandoned/incomplete uploads after this many hours.
ATTACHMENT_ABANDONED_HOURS=24
# Delete attachments when a conversation is inactive this many days.
ATTACHMENT_RETENTION_DAYS=30

# ── Azure Text-to-Speech (optional cloud TTS) ────────────────────────────────
# Browser TTS still works either way. Flip this on when you want Azure voices
# from the Nest API (same quality in Chrome, Firefox, Brave, etc.).
# Get key + region from your Azure AI Speech resource.
AZURE_TTS_ENABLED=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=canadacentral
